<!doctype html>
<html lang="zh-CN" data-theme="{{ theme }}">
  <head>
    <meta charset="utf-8" />
    {% if document.asset_base_url %}<base href="{{ document.asset_base_url.rstrip('/') }}/" />{% endif %}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      :root {
        color-scheme: light;
        --bg: #f3efe9;
        --paper: rgba(255, 254, 251, 0.97);
        --paper-soft: #faf6ef;
        --ink: #29251f;
        --muted: #756d62;
        --line: rgba(91, 74, 52, 0.13);
        --accent: #db5f3e;
        --accent-2: #eca53e;
        --qiqi: #8062c6;
        --qiqi-soft: #f2ecff;
        --chip: #f5e7da;
        --shadow: rgba(64, 43, 25, 0.15);
        --code: #f0e9df;
        --footer: #f7f2ff;
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --bg: #151311;
        --paper: rgba(34, 31, 28, 0.98);
        --paper-soft: #292520;
        --ink: #f4eee6;
        --muted: #bdb3a8;
        --line: rgba(255, 239, 219, 0.12);
        --accent: #ff7958;
        --accent-2: #f3b44f;
        --qiqi: #b69cff;
        --qiqi-soft: #302943;
        --chip: #493229;
        --shadow: rgba(0, 0, 0, 0.4);
        --code: #322d28;
        --footer: #272233;
      }
      * { box-sizing: border-box; }
      html, body { width: {{ render_width }}px; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        padding: 34px;
        color: var(--ink);
        background:
          radial-gradient(circle at 8% 2%, rgba(236, 165, 62, 0.25), transparent 26%),
          radial-gradient(circle at 94% 11%, rgba(128, 98, 198, 0.20), transparent 31%),
          var(--bg);
        font-family: "Noto Sans CJK SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
        font-size: 18px;
        line-height: 1.78;
      }
      .card {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 30px;
        background: var(--paper);
        box-shadow: 0 24px 70px var(--shadow);
      }
      .hero {
        position: relative;
        display: grid;
        grid-template-columns: {% if cover_src %}minmax(0, 1.25fr) minmax(250px, .75fr){% else %}1fr{% endif %};
        min-height: 310px;
        overflow: hidden;
        border-bottom: 1px solid var(--line);
      }
      .hero::before,
      .hero::after {
        position: absolute;
        z-index: 0;
        border-radius: 50%;
        content: "";
        pointer-events: none;
      }
      .hero::before {
        top: -92px;
        left: -68px;
        width: 220px;
        height: 220px;
        background: rgba(236, 165, 62, 0.12);
      }
      .hero::after {
        right: 28%;
        bottom: -110px;
        width: 240px;
        height: 240px;
        background: rgba(128, 98, 198, 0.10);
      }
      .hero-copy {
        position: relative;
        z-index: 1;
        align-self: center;
        padding: 54px 48px 46px;
      }
      .hero-list {
        min-height: 230px;
        background:
          linear-gradient(120deg, rgba(128, 98, 198, 0.10), transparent 58%),
          linear-gradient(300deg, rgba(236, 165, 62, 0.10), transparent 55%);
      }
      .hero-list .hero-copy { padding-top: 43px; padding-bottom: 41px; }
      .kicker {
        display: flex;
        gap: 9px;
        align-items: center;
        margin-bottom: 16px;
        color: var(--accent);
        font-size: 14px;
        font-weight: 850;
        letter-spacing: .17em;
      }
      .kicker::before {
        display: grid;
        width: 25px;
        height: 25px;
        place-items: center;
        border-radius: 9px;
        color: #fff;
        background: linear-gradient(135deg, var(--qiqi), var(--accent));
        content: "Q";
        font-size: 13px;
        letter-spacing: 0;
      }
      h1 {
        margin: 0;
        font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif;
        font-size: 46px;
        line-height: 1.2;
        letter-spacing: -.03em;
      }
      .hero-list h1 { font-size: 42px; }
      .description { max-width: 650px; margin: 20px 0 0; color: var(--muted); font-size: 18px; }
      .cover { position: relative; z-index: 1; min-height: 310px; overflow: hidden; background: var(--paper-soft); }
      .cover img { display: block; width: 100%; height: 100%; min-height: 310px; object-fit: cover; }
      .cover::after {
        position: absolute;
        inset: 0;
        box-shadow: inset 32px 0 48px -42px rgba(0, 0, 0, .7);
        content: "";
        pointer-events: none;
      }
      .stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 24px 48px;
        border-bottom: 1px solid var(--line);
        background: var(--paper-soft);
      }
      .stat {
        display: inline-flex;
        gap: 8px;
        align-items: baseline;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--chip);
      }
      .stat-label { color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .05em; }
      .stat-value { font-size: 16px; font-weight: 750; }

      .search-content { padding: 31px 40px 38px; }
      .selection-guide {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-bottom: 20px;
        padding: 14px 17px;
        border: 1px solid color-mix(in srgb, var(--qiqi) 28%, transparent);
        border-radius: 16px;
        background: var(--qiqi-soft);
        color: var(--muted);
        font-size: 14px;
        line-height: 1.55;
      }
      .guide-mark {
        display: grid;
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        place-items: center;
        border-radius: 12px;
        color: #fff;
        background: linear-gradient(135deg, var(--qiqi), var(--accent));
        font-size: 18px;
        font-weight: 850;
      }
      .selection-guide strong { color: var(--ink); }
      .recipe-list { display: grid; gap: 15px; }
      .recipe-item {
        display: grid;
        grid-template-columns: 176px minmax(0, 1fr);
        min-height: 154px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--paper-soft);
        box-shadow: 0 7px 18px rgba(49, 38, 27, 0.06);
      }
      .recipe-thumb {
        position: relative;
        min-height: 154px;
        overflow: hidden;
        background:
          radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .34), transparent 28%),
          linear-gradient(145deg, var(--accent-2), var(--accent));
      }
      .recipe-thumb img { display: block; width: 100%; height: 100%; min-height: 154px; object-fit: cover; }
      .recipe-placeholder {
        display: grid;
        width: 100%;
        min-height: 154px;
        place-items: center;
        color: rgba(255, 255, 255, .92);
        font-size: 46px;
      }
      .recipe-index {
        position: absolute;
        top: 11px;
        left: 11px;
        z-index: 2;
        display: grid;
        min-width: 39px;
        height: 39px;
        padding: 0 8px;
        place-items: center;
        border: 2px solid rgba(255, 255, 255, .68);
        border-radius: 13px;
        color: #fff;
        background: rgba(30, 24, 20, .72);
        box-shadow: 0 5px 14px rgba(0, 0, 0, .23);
        font-size: 17px;
        font-weight: 850;
      }
      .recipe-copy {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px 20px 16px;
        text-align: left;
      }
      .recipe-title {
        overflow-wrap: anywhere;
        color: var(--ink);
        font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif;
        font-size: 24px;
        font-weight: 800;
        line-height: 1.32;
      }
      .recipe-heading { display: flex; gap: 10px; align-items: flex-start; }
      .kind-badge {
        flex: 0 0 auto;
        margin-top: 3px;
        padding: 3px 8px;
        border: 1px solid color-mix(in srgb, var(--qiqi) 30%, transparent);
        border-radius: 999px;
        color: var(--qiqi);
        background: var(--qiqi-soft);
        font-size: 10px;
        font-weight: 850;
        letter-spacing: .04em;
      }
      .match-row { display: flex; flex-wrap: wrap; gap: 6px; margin: 7px 0 10px; }
      .match-tag {
        padding: 2px 8px;
        border-radius: 999px;
        color: var(--qiqi);
        background: var(--qiqi-soft);
        font-size: 11px;
        font-weight: 750;
      }
      .recipe-meta { display: flex; flex-wrap: wrap; gap: 7px 9px; align-items: flex-end; margin-top: auto; }
      .meta-pill {
        display: inline-flex;
        gap: 5px;
        align-items: baseline;
        padding: 4px 8px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--paper);
        line-height: 1.35;
      }
      .meta-label { color: var(--muted); font-size: 11px; font-weight: 700; }
      .meta-value { color: var(--ink); font-size: 12px; font-weight: 750; }
      .recipe-note {
        margin-top: 9px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }
      .recipe-item[data-kind="tip"] .recipe-thumb {
        background:
          radial-gradient(circle at 68% 22%, rgba(255, 255, 255, .28), transparent 30%),
          linear-gradient(145deg, var(--qiqi), #564398);
      }
      .empty-state {
        padding: 50px 25px;
        border: 1px dashed var(--line);
        border-radius: 20px;
        color: var(--muted);
        background: var(--paper-soft);
        text-align: center;
      }
      .empty-icon { display: block; margin-bottom: 9px; font-size: 38px; }

      .menu-content { padding: 31px 40px 39px; }
      .menu-groups { display: grid; gap: 23px; }
      .menu-group {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: color-mix(in srgb, var(--paper-soft) 84%, transparent);
      }
      .menu-group-title {
        display: flex;
        gap: 11px;
        align-items: center;
        padding: 13px 18px;
        border-bottom: 1px solid var(--line);
        background: var(--chip);
        font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif;
        font-size: 19px;
        font-weight: 850;
      }
      .menu-group-icon {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border-radius: 12px;
        background: var(--paper);
        font-size: 19px;
      }
      .menu-items { display: grid; gap: 12px; padding: 14px; }
      .menu-items .recipe-item { min-height: 140px; border-radius: 17px; }
      .menu-items .recipe-thumb,
      .menu-items .recipe-thumb img,
      .menu-items .recipe-placeholder { min-height: 140px; }

      .stats-content { display: grid; gap: 22px; padding: 35px 40px 42px; }
      .chart-card {
        padding: 22px 24px 24px;
        border: 1px solid var(--line);
        border-radius: 21px;
        background: var(--paper-soft);
      }
      .chart-title {
        margin: 0;
        padding: 0;
        border: 0;
        font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif;
        font-size: 23px;
        font-weight: 850;
      }
      .chart-title::before { display: none; content: none; }
      .chart-description { margin: 4px 0 18px; color: var(--muted); font-size: 13px; }
      .chart-bars { display: grid; gap: 11px; }
      .chart-row { display: grid; grid-template-columns: 130px minmax(0, 1fr) 48px; gap: 12px; align-items: center; }
      .chart-label { overflow: hidden; font-size: 13px; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
      .chart-track { height: 12px; overflow: hidden; border-radius: 999px; background: var(--code); }
      .chart-fill {
        display: block;
        width: max(4px, var(--bar));
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--qiqi), var(--accent), var(--accent-2));
      }
      .chart-value { color: var(--muted); font-size: 12px; font-weight: 750; text-align: right; }

      .content { padding: 40px 48px 28px; }
      .content > :first-child { margin-top: 0; }
      .content > :last-child { margin-bottom: 0; }
      h2, h3, h4, h5, h6 {
        color: var(--ink);
        font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif;
        line-height: 1.35;
      }
      h2 { margin: 1.8em 0 .75em; padding-bottom: .42em; border-bottom: 2px solid var(--line); font-size: 30px; }
      h2::before { display: inline-block; width: 8px; height: .8em; margin-right: 12px; border-radius: 9px; background: linear-gradient(var(--accent), var(--accent-2)); content: ""; }
      h3 { margin: 1.55em 0 .6em; font-size: 24px; }
      h4 { margin: 1.35em 0 .5em; font-size: 20px; }
      p { margin: .8em 0; }
      ul, ol { margin: .65em 0 1em; padding-left: 1.65em; }
      li { margin: .34em 0; padding-left: .18em; }
      li::marker { color: var(--accent); font-weight: 800; }
      blockquote { margin: 1.2em 0; padding: 14px 20px; border-left: 5px solid var(--accent); border-radius: 0 14px 14px 0; color: var(--muted); background: var(--paper-soft); }
      code { padding: .14em .38em; border-radius: 7px; color: var(--accent); background: var(--code); font-family: "JetBrains Mono", "Noto Sans Mono CJK SC", monospace; font-size: .88em; }
      pre { overflow-wrap: anywhere; padding: 20px; border: 1px solid var(--line); border-radius: 15px; background: var(--code); white-space: pre-wrap; }
      pre code { padding: 0; color: var(--ink); background: transparent; }
      a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .content img { display: block; max-width: 100%; max-height: 820px; margin: 24px auto; border-radius: 18px; box-shadow: 0 12px 32px var(--shadow); object-fit: contain; }
      table { width: 100%; margin: 22px 0; overflow: hidden; border: 1px solid var(--line); border-spacing: 0; border-collapse: separate; border-radius: 14px; font-size: 15px; }
      th, td { padding: 11px 12px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      th { background: var(--chip); font-weight: 750; }
      tr:last-child td { border-bottom: 0; }
      th:last-child, td:last-child { border-right: 0; }

      .footer {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        padding: 19px 28px 22px;
        border-top: 1px dashed color-mix(in srgb, var(--qiqi) 32%, transparent);
        background: var(--footer);
        text-align: center;
      }
      .footer-unit { padding: 2px 13px; }
      .footer-unit + .footer-unit { border-left: 1px solid var(--line); }
      .footer-label { display: block; color: var(--muted); font-size: 11px; font-weight: 750; letter-spacing: .07em; }
      .footer-value { display: block; margin-top: 2px; color: var(--ink); font-size: 13px; font-weight: 800; }
      .footer-brand .footer-label { color: var(--qiqi); font-size: 13px; font-weight: 900; letter-spacing: .1em; }
    </style>
  </head>
  <body>
    {% macro choice_card(item) -%}
      <section class="recipe-item" data-kind="{{ item.kind }}">
        <div class="recipe-thumb">
          <span class="recipe-index">{{ item.number }}</span>
          {% if item.cover_url %}
            <img src="{{ item.cover_url }}" alt="{{ item.cover_alt }}" />
          {% else %}
            <div class="recipe-placeholder">{% if item.kind == 'tip' %}📚{% else %}🍳{% endif %}</div>
          {% endif %}
        </div>
        <div class="recipe-copy">
          <div>
            <div class="recipe-heading">
              <span class="kind-badge">{{ item.badge }}</span>
              <div class="recipe-title">{{ item.title }}</div>
            </div>
            {% if item.matched %}
              <div class="match-row">
                {% for matched in item.matched %}<span class="match-tag">命中 · {{ matched }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>
          <div>
            <div class="recipe-meta">
              {% for label, value in item.metadata %}
                <span class="meta-pill"><span class="meta-label">{{ label }}</span><span class="meta-value">{{ value }}</span></span>
              {% endfor %}
            </div>
            {% if item.note %}<div class="recipe-note">{{ item.note }}</div>{% endif %}
          </div>
        </div>
      </section>
    {%- endmacro %}
    <main class="card">
      <header class="hero{% if document.layout != 'article' %} hero-list{% endif %}">
        <div class="hero-copy">
          <div class="kicker">{{ document.kicker }}</div>
          <h1>{{ document.title }}</h1>
          {% if document.description %}<p class="description">{{ document.description }}</p>{% endif %}
        </div>
        {% if cover_src and document.layout == 'article' %}
          <div class="cover"><img src="{{ cover_src }}" alt="{{ document.cover_alt }}" /></div>
        {% endif %}
      </header>
      {% if document.stats %}
        <section class="stats">
          {% for label, value in document.stats %}
            <div class="stat"><span class="stat-label">{{ label }}</span><span class="stat-value">{{ value }}</span></div>
          {% endfor %}
        </section>
      {% endif %}
      {% if document.layout == 'recipe_list' %}
        <article class="search-content">
          {% if document.recipe_choices %}
            <div class="selection-guide">
              <span class="guide-mark">#</span>
              <span><strong>发送下方序号即可查看完整内容</strong><br />菜谱会打开完整做法，技巧会打开全文；也可以发送“取消”结束选择。</span>
            </div>
            <div class="recipe-list">
              {% for item in document.recipe_choices %}
                {{ choice_card(item) }}
              {% endfor %}
            </div>
          {% else %}
            <div class="empty-state"><span class="empty-icon">🍽️</span>没有找到匹配内容，换个菜名、拼音、原料或知识关键词再试试。</div>
          {% endif %}
        </article>
      {% elif document.layout == 'menu' %}
        <article class="menu-content">
          {% if document.recipe_choices %}
            <div class="selection-guide">
              <span class="guide-mark">#</span>
              <span><strong>这桌菜可以继续点开看做法</strong><br />发送菜名前的序号即可查看完整菜谱，也可以发送“取消”结束选择。</span>
            </div>
          {% endif %}
          <div class="menu-groups">
            {% for group in document.choice_groups %}
              <section class="menu-group">
                <div class="menu-group-title"><span class="menu-group-icon">{{ group.icon }}</span>{{ group.title }}</div>
                {% if group.items %}
                  <div class="menu-items">
                    {% for item in group.items %}{{ choice_card(item) }}{% endfor %}
                  </div>
                {% else %}
                  <div class="empty-state">本次没有安排这一类菜。</div>
                {% endif %}
              </section>
            {% endfor %}
          </div>
        </article>
      {% elif document.layout == 'stats' %}
        <article class="stats-content">
          {% for chart in document.charts %}
            <section class="chart-card">
              <h2 class="chart-title">{{ chart.title }}</h2>
              {% if chart.description %}<p class="chart-description">{{ chart.description }}</p>{% endif %}
              <div class="chart-bars">
                {% for bar in chart.bars %}
                  <div class="chart-row">
                    <span class="chart-label">{{ bar.label }}</span>
                    <span class="chart-track"><span class="chart-fill" style="--bar: {{ bar.percent }}%"></span></span>
                    <span class="chart-value">{{ bar.value }}</span>
                  </div>
                {% endfor %}
              </div>
            </section>
          {% endfor %}
        </article>
      {% else %}
        <article class="content">{{ body_html }}</article>
      {% endif %}
      <footer class="footer">
        <div class="footer-unit footer-brand"><span class="footer-label">QIQI-Bot</span><span class="footer-value">作者 LoCCai</span></div>
        <div class="footer-unit"><span class="footer-label">数据驱动</span><span class="footer-value">How To Cook</span></div>
        <div class="footer-unit"><span class="footer-label">渲染时间</span><span class="footer-value">{{ rendered_at }}</span></div>
      </footer>
    </main>
  </body>
</html>
